# InfraScope environment. Copy to .env and change every "change-me" value.
# .env is git-ignored; never commit real credentials.
# Passwords are embedded in connection URLs, so use URL-safe characters (letters, digits, - _ .).

# --- Published ports -------------------------------------------------------
# Interface the published ports bind to. Keep 127.0.0.1 unless you have put
# TLS and OTLP authentication in place (see docs/runbook.md).
INFRASCOPE_BIND=127.0.0.1
DASHBOARD_PORT=8080
DEMO_SERVICE_PORT=8082
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
# Role for the InfraScope configuration database (infrascope).
INFRASCOPE_DB_PASSWORD=change-me-infrascope
# Role for the demo service's database (shop).
SHOP_DB_PASSWORD=change-me-shop

# --- ClickHouse --------------------------------------------------------------
CLICKHOUSE_USER=infrascope
CLICKHOUSE_PASSWORD=change-me-clickhouse

# --- InfraScope admin login (used from Phase 2) ----------------------------
INFRASCOPE_ADMIN_USER=admin
INFRASCOPE_ADMIN_PASSWORD=change-me-admin

# --- Demo data ---------------------------------------------------------------
# Deterministic shop data created on the demo service's first start. The S1
# "missing index" slowdown needs a large orders table; smaller values start
# faster (CI uses 100000 orders).
DEMO_SEED_PRODUCTS=10000
DEMO_SEED_CUSTOMERS=100000
DEMO_SEED_ORDERS=1000000

# --- Telemetry ---------------------------------------------------------------
# Trace and log retention, applied when the ClickHouse tables are created.
# Changing it later requires ALTER TABLE ... MODIFY TTL (docs/runbook.md).
TELEMETRY_TTL=72h
# Added to telemetry as deployment.environment.name when the sender omits it.
INFRASCOPE_ENVIRONMENT=local
